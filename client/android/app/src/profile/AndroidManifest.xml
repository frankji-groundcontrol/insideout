<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- rv4-COMP-06: the dev server speaks plain http, so a profile build may
         use cleartext for the loopback names in the config below and nothing
         else. Release never gets it (it is not under src/main). Emulator:
         API_BASE=http://10.0.2.2:8080/api/v1. Physical device: run
         `adb reverse tcp:8080 tcp:8080` and keep the default API_BASE. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
