# Nuxt runtime config (public). Overrides nuxt.config runtimeConfig.public.* at runtime.
# Mapping from the old Vite vars:
#   VITE_API_MODE         -> NUXT_PUBLIC_API_MODE         (runtimeConfig.public.apiMode)
#   VITE_BUNDLE_AUTH      -> NUXT_PUBLIC_BUNDLE_AUTH       (runtimeConfig.public.bundleAuth)
#   VITE_BUNDLE_DATA      -> NUXT_PUBLIC_BUNDLE_DATA       (runtimeConfig.public.bundleData)
#   VITE_BUNDLE_AI_EXPORT -> NUXT_PUBLIC_BUNDLE_AI_EXPORT  (runtimeConfig.public.bundleAiExport)
#   VITE_SUPABASE_URL     -> NUXT_PUBLIC_SUPABASE_URL      (runtimeConfig.public.supabaseUrl)
#   VITE_SUPABASE_ANON_KEY-> NUXT_PUBLIC_SUPABASE_ANON_KEY (runtimeConfig.public.supabaseAnonKey)

# Global adapter mode. Empty / unset => 'mock' (zero-config mock-by-default).
# Set to 'supabase' to use the real Supabase-backed services.
NUXT_PUBLIC_API_MODE=mock

# Per-bundle overrides (optional). If unset, each falls back to NUXT_PUBLIC_API_MODE.
# NUXT_PUBLIC_BUNDLE_AUTH=supabase
# NUXT_PUBLIC_BUNDLE_DATA=supabase
# NUXT_PUBLIC_BUNDLE_AI_EXPORT=supabase

# Required only when any bundle uses 'supabase'. The anon key is a publishable key,
# so exposure under public.* is acceptable.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
