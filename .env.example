# PostgreSQL — single role `insideout_app` owns the whole database.
# PostgreSQL——单一角色 `insideout_app` 拥有整个数据库。
#
# DATABASE_URL is REQUIRED — docker-compose can't derive it from the other
# vars below (Compose doesn't support nesting ${...} inside a :- default),
# so set it explicitly for whichever of the two setups you're using:
# DATABASE_URL 为必填项——docker-compose 无法从下面的变量派生它（Compose 不支持
# 在 :- 默认值中嵌套 ${...}），因此必须为下述两种用法之一显式设置：
#
#   (a) Remote instance (dev default) — any host, e.g. Neon/RDS/self-managed.
#       The role named in the URL must own that database (so it also owns
#       `public` within it).
#       远程实例（开发默认）——任意主机。URL 中的角色必须拥有该数据库
#       （从而也拥有其中的 public schema）。
DATABASE_URL=postgres://insideout_app:change_me@your-remote-host:5432/insideout?sslmode=require
#
#   (b) Bundled docker-compose `postgres` service (self-hosted deploy
#       default) — point at it instead, using the SAME password as
#       POSTGRES_APP_PASSWORD below:
#       自带的 docker-compose postgres 服务（自托管部署默认项）——改为指向它，
#       密码需与下面的 POSTGRES_APP_PASSWORD 一致：
#   DATABASE_URL=postgres://insideout_app:change_me_app@postgres:5432/insideout?sslmode=disable

POSTGRES_PORT=5442
POSTGRES_APP_PASSWORD=change_me_app
# Only used to bootstrap the bundled postgres service (setup (b) above) —
# the app never connects with this. See docker/postgres-init/.
# 仅用于引导自带的 postgres 服务（上文用法 b）——应用本身从不用它连接。见 docker/postgres-init/。
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser

# Go server / Go 服务
SERVER_PORT=8080
INSIDEOUT_JWT_SECRET=change_me_to_a_long_random_string
INSIDEOUT_ACCESS_TTL=15m
INSIDEOUT_REFRESH_TTL=720h

# AI provider (Anthropic Messages API compatible) / AI 供应商（兼容 Anthropic Messages API）
# Leave ANTHROPIC_AUTH_TOKEN empty for offline template-reply dev mode.
# 留空 ANTHROPIC_AUTH_TOKEN 即为离线模板回复开发模式。
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=
AI_MODEL=claude-sonnet-4-20250514

# Frontend / 前端
APP_PORT=3000
